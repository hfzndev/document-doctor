# Copy to .env.local (dev) or pass as environment variables (Docker). Never commit real secrets.

# Public origin of this app. Must EXACTLY match the `docs` app origin registered in
# norflabs-auth (bootstrap.py APPS / console), or auth will refuse to redirect back.
APP_PUBLIC_URL=https://docs.norflabs.com

# Signs this app's own session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Norflabs Auth
NL_AUTH_BASE_URL=https://auth.norflabs.com
NL_APP_SLUG=docs
# Fallback session length in hours (norflabs-auth's per-app session_hours wins when set)
SESSION_HOURS=12

# Where the SQLite database and uploaded templates are stored
DATA_DIR=./data

# Time zone for "today" in date fields and for auto-number periods (yearly / monthly)
APP_TIMEZONE=Asia/Jakarta

# LibreOffice binary used for PDF export
SOFFICE_PATH=soffice
MAX_UPLOAD_MB=20

# Local development only: adds an email-only sign-in form to /login. NEVER enable in production.
AUTH_DEV_LOGIN=false
